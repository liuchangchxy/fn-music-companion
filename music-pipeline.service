[Unit]
Description=Local music organization pipeline
After=network-online.target

[Service]
Type=simple
User=chang
Group=Users
Environment=INCOMING=/vol2/1000/Download/音乐/整理前
Environment=LIBRARY=/vol2/1000/Download/音乐/整理后
Environment=DB=/vol4/1000/docker/music-pipeline/data/music.db
Environment=NCM=/vol4/1000/docker/music-pipeline/ncmdump
Environment=FPCALC=/vol4/1000/docker/music-pipeline/fpcalc
ExecStart=/usr/bin/python3 /vol4/1000/docker/music-pipeline/music_pipeline.py watch
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
